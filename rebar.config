{erl_opts, [debug_info]}.
{deps, []}.

{escript_name, ides}.
{escript_main_app, ides}.
{escript_incl_apps, [syntax_tools]}.
{escript_emu_args, "%%! -escript main ides_cli\n"}.
{project_plugins, [erlfmt, rebar3_ex_doc, rebar3_hex, rebar3_lint]}.

{erlfmt, [
    write,
    {files, ["rebar.config", "{src,test}/*.{erl,hrl}"]}
]}.

{dialyzer, [
    {get_warnings, true},
    {plt_extra_apps, [syntax_tools]}
]}.

{hex, [{doc, ex_doc}]}.

{elvis, [
    {config, [
        #{
            files => ["src/*.erl", "test/*.erl"],
            ruleset => erl_files,
            rules => [
                {elvis_style, no_debug_call, #{
                    ignore => [
                        {ides_printer, print},
                        {ides_printer, print_detail},
                        {ides_printer, print_init_analysis},
                        {ides_prettypr, print},
                        {ides_static, print},
                        {ides_cli, main}
                    ]
                }},
                {elvis_style, dont_repeat_yourself, #{
                    ignore => [ides_static_tests, ides_prettypr, ides_static_parse]
                }}
            ]
        },
        #{
            files => ["rebar.config"],
            ruleset => rebar_config
        }
    ]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{ex_doc, [
    {extras, ["README.md"]},
    {source_url, "https://github.com/pmonson711/ides"},
    {main, "README.md"}
]}.
